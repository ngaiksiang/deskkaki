---
import { SITE, CATEGORIES } from '../data/site';
import { u } from '../data/url';
const { title, description = SITE.description, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en-SG">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={SITE.locale} />
<meta name="twitter:card" content="summary" />
<link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
<link rel="sitemap" href={u('/sitemap-index.xml')} />
<style is:global>
:root{--ink:#1d2433;--muted:#5b6475;--bg:#fbfaf7;--card:#fff;--line:#e6e2d9;--brand:#0f766e;--brand2:#ccfbf1;--warn:#fff7e6}
*{box-sizing:border-box}body{margin:0;font:17px/1.65 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--ink);background:var(--bg)}
a{color:var(--brand)}.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
header{background:#fff;border-bottom:1px solid var(--line)}header .wrap{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;padding-top:14px;padding-bottom:14px}
.logo{font-weight:800;font-size:22px;text-decoration:none;color:var(--ink)}.logo span{color:var(--brand)}
nav a{margin-left:16px;text-decoration:none;color:var(--muted);font-weight:500}nav a:hover{color:var(--brand)}
main{padding:32px 0 56px}h1{line-height:1.2;font-size:clamp(28px,4vw,40px);margin:.2em 0 .4em}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:20px}.card h3{margin-top:0;line-height:1.3}
.card a.title{text-decoration:none;color:var(--ink)}.muted{color:var(--muted)}.tag{display:inline-block;background:var(--brand2);color:var(--brand);border-radius:99px;padding:2px 10px;font-size:13px;font-weight:600;text-decoration:none}
.btn{display:inline-block;background:var(--brand);color:#fff;padding:10px 16px;border-radius:8px;text-decoration:none;font-weight:600}
.disclosure{background:var(--warn);border:1px solid #f3d9a4;border-radius:10px;padding:12px 16px;font-size:15px;margin:16px 0 24px}
article{max-width:760px}table{border-collapse:collapse;width:100%;font-size:15px;display:block;overflow-x:auto}th,td{border:1px solid var(--line);padding:8px 10px;text-align:left;vertical-align:top}th{background:#f3f1ec}
footer{border-top:1px solid var(--line);background:#fff;padding:28px 0;font-size:14px;color:var(--muted)}footer a{color:var(--muted);margin-right:14px}
@media(max-width:600px){nav a{margin:0 12px 0 0}}
</style>
</head>
<body>
<header><div class="wrap"><a class="logo" href={u('/')}>Desk<span>Kaki</span></a>
<nav>{CATEGORIES.map(c => <a href={u(`/category/${c.slug}/`)}>{c.name}</a>)}<a href={u('/about/')}>About</a></nav></div></header>
<main><div class="wrap"><slot /></div></main>
<footer><div class="wrap">
<p><a href={u('/about/')}>About</a><a href={u('/affiliate-disclosure/')}>Affiliate Disclosure</a><a href={u('/privacy/')}>Privacy Policy</a><a href={u('/contact/')}>Contact</a></p>
<p>© {new Date().getFullYear()} {SITE.name}. Some links may be affiliate links; we may earn a commission at no extra cost to you. Prices change often, so always check the retailer.</p>
</div></footer>
</body></html>
